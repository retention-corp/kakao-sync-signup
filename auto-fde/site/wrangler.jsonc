{
	// auto-fde public pages (landing, terms, privacy, ad consent). Static assets only, no Worker code.
	// Deploy: from this folder, with CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID in the environment,
	//   npx wrangler deploy
	// Zone retn.kr lives in the same Cloudflare account as danbi.retn.kr.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auto-fde-site",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./public",
		"html_handling": "auto-trailing-slash"
	},
	"routes": [{ "pattern": "auto-fde.retn.kr", "custom_domain": true }],
	"workers_dev": false
}
